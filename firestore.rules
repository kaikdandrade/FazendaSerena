rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email is string;
    }

    // A coleção administrators é a única fonte de autorização do painel.
    // Novos registros usam o e-mail como ID; documentos antigos pelo UID
    // continuam válidos para não interromper contas administrativas existentes.
    function isAdministrator() {
      return hasVerifiedEmail()
             && (
               (exists(/databases/$(database)/documents/administrators/$(request.auth.token.email))
                 && get(/databases/$(database)/documents/administrators/$(request.auth.token.email)).data.enabled == true)
               ||
               (exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
                 && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true)
             );
    }

    function validAdminPayload() {
      return request.resource.data.keys().hasOnly([
               'enabled', 'email', 'displayName', 'createdAt', 'createdAtClient', 'createdBy'
             ])
             && request.resource.data.enabled == true
             && request.resource.data.email is string
             && request.resource.data.email.size() >= 5
             && request.resource.data.email.size() <= 160
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() <= 80
             && request.resource.data.createdAtClient is int
             && request.resource.data.createdBy is string;
    }

    match /administrators/{adminId} {
      // A própria conta pode ler seu documento para descobrir se possui acesso.
      // Listagens e qualquer mutação exigem que a conta já seja administradora.
      allow get: if hasVerifiedEmail()
                 && (adminId == request.auth.token.email
                     || adminId == request.auth.uid
                     || isAdministrator());
      allow list: if isAdministrator();
      allow create, update: if isAdministrator()
                            && validAdminPayload()
                            && request.resource.data.email == adminId;
      allow delete: if isAdministrator();
    }

    match /gameConfig/public {
      allow read: if true;
      allow create, update: if isAdministrator()
                            && request.resource.data.keys().hasOnly([
                              'config',
                              'schemaVersion',
                              'updatedAt',
                              'updatedAtClient',
                              'updatedBy'
                            ])
                            && request.resource.data.config is map
                            && request.resource.data.schemaVersion is int
                            && request.resource.data.schemaVersion >= 1
                            && request.resource.data.updatedAtClient is int
                            && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdministrator();
    }

    match /playerFeedback/{feedbackId} {
      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'userId', 'email', 'displayName', 'type', 'subject', 'message',
                      'status', 'gameVersion', 'createdAt', 'createdAtClient'
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 160
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.type in ['idea', 'feedback', 'problem']
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() >= 3
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 8
                    && request.resource.data.message.size() <= 1200
                    && request.resource.data.status == 'new'
                    && request.resource.data.gameVersion is string
                    && request.resource.data.gameVersion.size() <= 30
                    && request.resource.data.createdAtClient is int;
      allow read: if isAdministrator();
      allow update: if isAdministrator()
                    && request.resource.data.keys().hasOnly([
                      'userId', 'email', 'displayName', 'type', 'subject', 'message',
                      'status', 'gameVersion', 'createdAt', 'createdAtClient',
                      'reviewedAt', 'reviewedAtClient', 'reviewedBy'
                    ])
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.displayName == resource.data.displayName
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.subject == resource.data.subject
                    && request.resource.data.message == resource.data.message
                    && request.resource.data.gameVersion == resource.data.gameVersion
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.createdAtClient == resource.data.createdAtClient
                    && request.resource.data.status in ['new', 'read'];
      allow delete: if isAdministrator();
    }

    match /players/{userId}/saves/main {
      allow read, delete: if request.auth != null
                          && request.auth.uid == userId;

      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'state',
                              'saveVersion',
                              'updatedAt',
                              'updatedAtClient'
                            ])
                            && request.resource.data.state is map
                            && (
                              (request.resource.data.saveVersion is string
                                && request.resource.data.saveVersion.size() >= 5
                                && request.resource.data.saveVersion.size() <= 20)
                              || request.resource.data.saveVersion is int
                            )
                            && request.resource.data.updatedAtClient is int;
    }

    match /prestigeLeaderboard/{userId} {
      // O ranking é público: visitantes também podem consultar o top 5.
      allow read: if true;
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && !isAdministrator()
                            && request.resource.data.keys().hasOnly([
                              'displayName',
                              'avatarId',
                              'profileComplete',
                              'prestigeTotal',
                              'prestigeCount',
                              'farmLevel',
                              'maxFarmLevel',
                              'updatedAt',
                              'updatedAtClient'
                            ])
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 4
                            && request.resource.data.displayName.size() <= 24
                            && request.resource.data.avatarId is string
                            && request.resource.data.avatarId.size() >= 1
                            && request.resource.data.avatarId.size() <= 48
                            && request.resource.data.profileComplete == true
                            && request.resource.data.prestigeTotal is int
                            && request.resource.data.prestigeTotal >= 0
                            && request.resource.data.prestigeCount is int
                            && request.resource.data.prestigeCount >= 0
                            && request.resource.data.farmLevel is int
                            && request.resource.data.farmLevel >= 1
                            && request.resource.data.maxFarmLevel is int
                            && request.resource.data.maxFarmLevel >= 1
                            && request.resource.data.updatedAtClient is int
                            && request.resource.data.displayName == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.settings.playerNickname
                            && request.resource.data.avatarId == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.settings.playerAvatar
                            && request.resource.data.prestigeTotal == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.totalPrestigeEarned
                            && request.resource.data.prestigeCount == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.prestiges
                            && request.resource.data.farmLevel == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.farmLevel
                            && request.resource.data.maxFarmLevel == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.maxFarmLevel;
    }

    match /friendProfiles/{userId} {
      allow read: if signedIn();
      allow delete: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
                            && request.auth.uid == userId
                            && request.resource.data.keys().hasOnly([
                              'displayName',
                              'avatarId',
                              'friendCode',
                              'profileComplete',
                              'updatedAt',
                              'updatedAtClient'
                            ])
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 4
                            && request.resource.data.displayName.size() <= 24
                            && request.resource.data.avatarId is string
                            && request.resource.data.avatarId.size() >= 1
                            && request.resource.data.avatarId.size() <= 48
                            && request.resource.data.friendCode == userId
                            && request.resource.data.profileComplete == true
                            && request.resource.data.updatedAtClient is int;
    }

    match /friendships/{friendshipId} {
      // Consultas da lista usam array-contains(members, uid), portanto todo
      // documento retornado precisa pertencer à própria conta autenticada.
      allow get, list: if signedIn()
                       && request.auth.uid in resource.data.members;

      allow create: if signedIn()
                    && request.resource.data.keys().hasOnly([
                      'members',
                      'requestedBy',
                      'status',
                      'createdAt',
                      'updatedAt',
                      'updatedAtClient'
                    ])
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 2
                    && request.resource.data.members[0] is string
                    && request.resource.data.members[1] is string
                    && request.resource.data.members[0] != request.resource.data.members[1]
                    && friendshipId == request.resource.data.members[0] + '__' + request.resource.data.members[1]
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.requestedBy == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAtClient is int
                    && exists(/databases/$(database)/documents/friendProfiles/$(request.resource.data.members[0]))
                    && exists(/databases/$(database)/documents/friendProfiles/$(request.resource.data.members[1]));

      // Somente o destinatário de uma solicitação pendente pode aceitá-la.
      // Nenhum campo estrutural da amizade pode ser trocado na aceitação.
      allow update: if signedIn()
                    && request.auth.uid in resource.data.members
                    && resource.data.status == 'pending'
                    && resource.data.requestedBy != request.auth.uid
                    && request.resource.data.members == resource.data.members
                    && request.resource.data.requestedBy == resource.data.requestedBy
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.status == 'accepted'
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAtClient is int
                    && request.resource.data.keys().hasOnly([
                      'members',
                      'requestedBy',
                      'status',
                      'createdAt',
                      'updatedAt',
                      'updatedAtClient'
                    ]);

      // Tanto quem enviou quanto quem recebeu pode cancelar/recusar/remover.
      allow delete: if signedIn()
                    && request.auth.uid in resource.data.members;
    }
  }
}
