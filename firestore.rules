rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Regras oficiais do Fazenda Serena.
    // Princípios: menor privilégio, isolamento por UID, administração autenticada,
    // validação de schema e projeções públicas vinculadas ao save do jogador.
    function signedIn() {
      return request.auth != null;
    }

    function hasVerifiedEmail() {
      return signedIn()
             && request.auth.token.email_verified == true
             && request.auth.token.email is string;
    }

    // A coleção administrators é a única fonte de autorização do painel.
    // Novos registros usam o e-mail como ID; documentos antigos pelo UID
    // continuam válidos para não interromper contas administrativas existentes.
    function isAdministrator() {
      return hasVerifiedEmail()
             && (
               (exists(/databases/$(database)/documents/administrators/$(request.auth.token.email))
                 && get(/databases/$(database)/documents/administrators/$(request.auth.token.email)).data.enabled == true)
               ||
               (exists(/databases/$(database)/documents/administrators/$(request.auth.uid))
                 && get(/databases/$(database)/documents/administrators/$(request.auth.uid)).data.enabled == true)
             );
    }

    function moderationExists(userId) {
      return exists(/databases/$(database)/documents/playerModeration/$(userId));
    }

    function isBannedUser(userId) {
      return moderationExists(userId)
             && get(/databases/$(database)/documents/playerModeration/$(userId)).data.banned == true;
    }

    function isRankingBlockedUser(userId) {
      return moderationExists(userId)
             && get(/databases/$(database)/documents/playerModeration/$(userId)).data.rankingBlocked == true;
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    // O motor econômico roda no cliente e evolui com frequência. As Rules
    // validam estrutura, autoria, invariantes críticas e projeções públicas, sem
    // tentar reimplementar toda a economia do jogo no Firestore.
    function validClientPlayerState() {
      let state = request.resource.data.state;
      return state is map
             && state.keys().hasAll([
               'version', 'coins', 'research', 'prestigePoints', 'farmLevel',
               'farmXP', 'crops', 'settings', 'stats', 'lastUpdate', 'createdAt'
             ])
             && isNumber(state.coins)
             && isNumber(state.research)
             && state.research >= 0
             && isNumber(state.prestigePoints)
             && state.prestigePoints >= 0
             && state.farmLevel is int
             && state.farmLevel >= 1
             && state.farmLevel <= 1000000
             && isNumber(state.farmXP)
             && state.farmXP >= 0
             && state.crops is map
             && state.settings is map
             && state.stats is map
             && state.lastUpdate is int
             && state.lastUpdate > 0
             && state.createdAt is int
             && state.createdAt > 0;
    }


    // Proteção cirúrgica dos recursos de prestígio observados nos testes.
    // Não reimplementa moedas, XP, pesquisa nem toda a economia do GameEngine.
    function hasPrestigeAuditFields(state) {
      return state is map
             && state.stats is map
             && state.stats.keys().hasAll(['prestiges', 'totalPrestigeEarned'])
             && state.stats.prestiges is int
             && state.stats.totalPrestigeEarned is int
             && state.stats.prestiges >= 0
             && state.stats.totalPrestigeEarned >= 0
             && isNumber(state.prestigePoints)
             && state.prestigePoints >= 0;
    }

    function isPrestigeCycleTransition(oldState, nextState) {
      return nextState.stats.prestiges == oldState.stats.prestiges + 1
             && nextState.farmLevel == 1
             && nextState.farmXP == 0
             && nextState.keys().hasAll(['activeContracts', 'contractOffers'])
             && nextState.activeContracts is list
             && nextState.contractOffers is list
             && nextState.activeContracts.size() == 0
             && nextState.contractOffers.size() == 0
             && nextState.stats.totalPrestigeEarned >= oldState.stats.totalPrestigeEarned;
    }

    function hasPrestigeRewardSourceChanged(oldState, nextState) {
      return (
               oldState.keys().hasAll(['missionsClaimed'])
               && nextState.keys().hasAll(['missionsClaimed'])
               && oldState.missionsClaimed is map
               && nextState.missionsClaimed is map
               && nextState.missionsClaimed != oldState.missionsClaimed
             )
             || (
               oldState.keys().hasAll(['activeContracts'])
               && nextState.keys().hasAll(['activeContracts'])
               && oldState.activeContracts is list
               && nextState.activeContracts is list
               && nextState.activeContracts != oldState.activeContracts
             );
    }

    function validSensitivePrestigeTransition() {
      let oldState = resource.data.state;
      let nextState = request.resource.data.state;

      // Compatibilidade: saves antigos podem ser normalizados na primeira gravação válida.
      return !hasPrestigeAuditFields(oldState)
             || (
               hasPrestigeAuditFields(nextState)
               && nextState.stats.prestiges >= oldState.stats.prestiges
               && nextState.stats.prestiges <= oldState.stats.prestiges + 1
               && (
                 nextState.stats.prestiges == oldState.stats.prestiges
                 || isPrestigeCycleTransition(oldState, nextState)
               )
               && nextState.stats.totalPrestigeEarned >= oldState.stats.totalPrestigeEarned
               && (
                 nextState.stats.totalPrestigeEarned == oldState.stats.totalPrestigeEarned
                 || isPrestigeCycleTransition(oldState, nextState)
                 || hasPrestigeRewardSourceChanged(oldState, nextState)
               )
               && (
                 nextState.prestigePoints <= oldState.prestigePoints
                 || (
                   nextState.stats.totalPrestigeEarned - oldState.stats.totalPrestigeEarned
                     >= nextState.prestigePoints - oldState.prestigePoints
                   && (
                     isPrestigeCycleTransition(oldState, nextState)
                     || hasPrestigeRewardSourceChanged(oldState, nextState)
                   )
                 )
               )
             );
    }

    function validClientSaveEnvelope(userId) {
      return signedIn()
             && request.auth.uid == userId
             && !isBannedUser(userId)
             && request.resource.data.keys().hasAll(['state', 'saveVersion', 'updatedAt', 'updatedAtClient'])
             && request.resource.data.keys().hasOnly(['state', 'saveVersion', 'ownerEmail', 'adminMutationId', 'updatedAt', 'updatedAtClient'])
             && request.resource.data.state is map
             && validClientPlayerState()
             && ((request.resource.data.saveVersion is string
                  && request.resource.data.saveVersion.size() >= 1
                  && request.resource.data.saveVersion.size() <= 24)
                 || request.resource.data.saveVersion is int)
             && (!request.resource.data.keys().hasAny(['ownerEmail'])
                 || (request.resource.data.ownerEmail is string
                     && request.auth.token.email is string
                     && request.resource.data.ownerEmail == request.auth.token.email))
             && (!request.resource.data.keys().hasAny(['adminMutationId'])
                 || (request.resource.data.adminMutationId is string
                     && request.resource.data.adminMutationId.size() <= 80))
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.updatedAt == request.time
             && request.resource.data.updatedAtClient is int
             && request.resource.data.updatedAtClient > 0;
    }

    // Salvar perfil usa update parcial e propositalmente não altera updatedAt.
    // Essa exceção continua limitada somente a apelido e avatar do perfil.
    function validProfileSettingsTransition(userId) {
      let oldState = resource.data.state;
      let nextState = request.resource.data.state;
      return signedIn()
             && request.auth.uid == userId
             && !isBannedUser(userId)
             && resource.data.state is map
             && request.resource.data.state is map
             && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state'])
             && nextState.diff(oldState).affectedKeys().hasOnly(['settings'])
             && oldState.settings is map
             && nextState.settings is map
             && nextState.settings.diff(oldState.settings).affectedKeys().hasOnly([
               'playerNickname', 'playerAvatar'
             ])
             && nextState.settings.playerNickname is string
             && nextState.settings.playerNickname.size() >= 4
             && nextState.settings.playerNickname.size() <= 24
             && nextState.settings.playerAvatar is string
             && nextState.settings.playerAvatar.size() >= 1
             && nextState.settings.playerAvatar.size() <= 48;
    }

    function validModerationPayload() {
      return request.resource.data.keys().hasOnly([
               'banned', 'rankingBlocked', 'reason', 'updatedAt', 'updatedAtClient', 'updatedBy'
             ])
             && request.resource.data.banned is bool
             && request.resource.data.rankingBlocked is bool
             && request.resource.data.reason is string
             && request.resource.data.reason.size() <= 240
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.updatedAt == request.time
             && request.resource.data.updatedAtClient is int
             && request.resource.data.updatedAtClient > 0
             && request.resource.data.updatedBy == request.auth.uid;
    }

    function validAdminPayload() {
      return request.resource.data.keys().hasOnly([
               'enabled', 'email', 'displayName', 'createdAt', 'createdAtClient', 'createdBy'
             ])
             && request.resource.data.enabled == true
             && request.resource.data.email is string
             && request.resource.data.email.size() >= 5
             && request.resource.data.email.size() <= 160
             && request.resource.data.displayName is string
             && request.resource.data.displayName.size() <= 80
             && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAtClient is int
             && request.resource.data.createdBy is string;
    }

    match /administrators/{adminId} {
      // A própria conta pode ler seu documento para descobrir se possui acesso.
      // Listagens e qualquer mutação exigem que a conta já seja administradora.
      allow get: if hasVerifiedEmail()
                 && (adminId == request.auth.token.email
                     || adminId == request.auth.uid
                     || isAdministrator());
      allow list: if isAdministrator();
      allow create, update: if isAdministrator()
                            && validAdminPayload()
                            && request.resource.data.email == adminId;
      // Impede que uma conta remova o próprio vínculo administrativo durante a sessão.
      allow delete: if isAdministrator()
                    && adminId != request.auth.token.email
                    && adminId != request.auth.uid;
    }

    match /gameConfig/public {
      allow read: if true;
      allow create, update: if isAdministrator()
                            && request.resource.data.keys().hasOnly([
                              'config',
                              'schemaVersion',
                              'updatedAt',
                              'updatedAtClient',
                              'updatedBy'
                            ])
                            && request.resource.data.config is map
                            && request.resource.data.schemaVersion is int
                            && request.resource.data.schemaVersion >= 1
                            && request.resource.data.updatedAt is timestamp
                            && request.resource.data.updatedAt == request.time
                            && request.resource.data.updatedAtClient is int
                            && request.resource.data.updatedAtClient > 0
                            && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if isAdministrator();
    }

    match /playerModeration/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdministrator());
      allow list: if isAdministrator();
      allow create, update: if isAdministrator() && validModerationPayload();
      allow delete: if isAdministrator();
    }

    match /playerFeedback/{feedbackId} {
      allow create: if signedIn()
                    && !isBannedUser(request.auth.uid)
                    && request.resource.data.keys().hasOnly([
                      'userId', 'email', 'displayName', 'type', 'subject', 'message',
                      'status', 'createdAt', 'createdAtClient'
                    ])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 160
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.type in ['idea', 'feedback', 'problem']
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() >= 3
                    && request.resource.data.subject.size() <= 100
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 8
                    && request.resource.data.message.size() <= 1200
                    && request.resource.data.status == 'new'
                    && request.resource.data.createdAt is timestamp
             && request.resource.data.createdAtClient is int
             && request.resource.data.createdAtClient > 0;
      allow read: if isAdministrator();
      allow update: if isAdministrator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status', 'reviewedAt', 'reviewedAtClient', 'reviewedBy'
                    ])
                    && request.resource.data.status in ['new', 'read']
                    && request.resource.data.reviewedAt is timestamp
                    && request.resource.data.reviewedAt == request.time
                    && request.resource.data.reviewedAtClient is int
                    && request.resource.data.reviewedAtClient > 0
                    && request.resource.data.reviewedBy == request.auth.uid;
      allow delete: if isAdministrator();
    }

    match /players/{userId}/saves/main {
      allow read: if (signedIn() && request.auth.uid == userId && !isBannedUser(userId))
                  || isAdministrator();
      allow delete: if isAdministrator();

      allow create: if validClientSaveEnvelope(userId)
                    || (isAdministrator()
                        && request.resource.data.keys().hasOnly(['state', 'saveVersion', 'ownerEmail', 'adminMutationId', 'updatedAt', 'updatedAtClient'])
                        && request.resource.data.state is map
                        && request.resource.data.updatedAt is timestamp
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.updatedAtClient is int
                        && request.resource.data.updatedAtClient > 0);

      allow update: if validProfileSettingsTransition(userId)
                    || (validClientSaveEnvelope(userId)
                        && validSensitivePrestigeTransition()
                        // A trava de concorrência do save normal usa o identificador da última
                        // mutação administrativa. A economia não é reimplementada nas Rules,
                        // evitando bloquear ações legítimas do GameEngine.
                        && ((!resource.data.keys().hasAny(['adminMutationId'])
                             && (!request.resource.data.keys().hasAny(['adminMutationId']) || request.resource.data.adminMutationId == ''))
                            || (resource.data.keys().hasAny(['adminMutationId'])
                                && request.resource.data.keys().hasAny(['adminMutationId'])
                                && resource.data.adminMutationId is string
                                && request.resource.data.adminMutationId == resource.data.adminMutationId))
                        && (!resource.data.state.keys().hasAny(['createdAt'])
                            || !request.resource.data.state.keys().hasAny(['createdAt'])
                            || request.resource.data.state.createdAt == resource.data.state.createdAt))
                    || (isAdministrator()
                        && request.resource.data.keys().hasOnly(['state', 'saveVersion', 'ownerEmail', 'adminMutationId', 'updatedAt', 'updatedAtClient'])
                        && request.resource.data.state is map
                        && request.resource.data.updatedAt is timestamp
                        && request.resource.data.updatedAt == request.time
                        && request.resource.data.updatedAtClient is int
                        && request.resource.data.updatedAtClient > 0);
    }

    // Operações globais do painel administrativo usam collectionGroup("saves").
    // Jogadores comuns continuam limitados ao próprio /players/{uid}/saves/main.
    match /{path=**}/saves/{saveId} {
      allow read: if isAdministrator();
      allow update: if isAdministrator()
                    && saveId == 'main'
                    && request.resource.data.keys().hasOnly([
                      'state',
                      'saveVersion',
                      'ownerEmail',
                      'adminMutationId',
                      'updatedAt',
                      'updatedAtClient'
                    ])
                    && request.resource.data.state is map
                    && request.resource.data.updatedAt is timestamp
                    && request.resource.data.updatedAt == request.time
                    && request.resource.data.updatedAtClient is int
                    && request.resource.data.updatedAtClient > 0;
      allow delete: if isAdministrator() && saveId == 'main';
    }

    match /prestigeLeaderboard/{userId} {
      // O ranking é público: visitantes também podem consultar o top 5.
      allow read: if true;
      allow delete: if (request.auth != null && request.auth.uid == userId) || isAdministrator();
      allow create, update: if request.auth != null
                            && request.auth.uid == userId
                            && !isAdministrator()
                            && !isBannedUser(userId)
                            && !isRankingBlockedUser(userId)
                            && request.resource.data.keys().hasOnly([
                              'displayName',
                              'avatarId',
                              'playerTitleId',
                              'profileComplete',
                              'prestigeTotal',
                              'prestigeCount',
                              'farmLevel',
                              'maxFarmLevel',
                              'updatedAt',
                              'updatedAtClient'
                            ])
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() >= 4
                            && request.resource.data.displayName.size() <= 24
                            && request.resource.data.avatarId is string
                            && request.resource.data.avatarId.size() >= 1
                            && request.resource.data.avatarId.size() <= 48
                            && (!request.resource.data.keys().hasAny(['playerTitleId'])
                                || (request.resource.data.playerTitleId is string
                                    && request.resource.data.playerTitleId.size() >= 1
                                    && request.resource.data.playerTitleId.size() <= 64
                                    && request.resource.data.playerTitleId == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.settings.playerTitle))
                            && request.resource.data.profileComplete == true
                            && request.resource.data.prestigeTotal is int
                            && request.resource.data.prestigeTotal >= 0
                            && request.resource.data.prestigeCount is int
                            && request.resource.data.prestigeCount >= 0
                            && request.resource.data.farmLevel is int
                            && request.resource.data.farmLevel >= 1
                            && request.resource.data.maxFarmLevel is int
                            && request.resource.data.maxFarmLevel >= 1
                            && request.resource.data.maxFarmLevel <= 1000000
                            && request.resource.data.farmLevel <= 1000000
                            && request.resource.data.updatedAt is timestamp
                            && request.resource.data.updatedAt == request.time
                            && request.resource.data.updatedAtClient is int
                            && request.resource.data.updatedAtClient > 0
                            && request.resource.data.prestigeTotal == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.totalPrestigeEarned
                            && request.resource.data.prestigeCount == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.prestiges
                            && request.resource.data.farmLevel == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.farmLevel
                            && request.resource.data.maxFarmLevel == getAfter(/databases/$(database)/documents/players/$(userId)/saves/main).data.state.stats.maxFarmLevel;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
